{
  "expo": {
    "name": "Map Extractor",
    "slug": "map-extractor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "map-extractor",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0c1427"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c1427"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
