# Environment Variables Configuration
PROJECT_NAME="Hospital Navigator API"
ENVIRONMENT="development"
DEBUG=True

# Database & Queue Configuration
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/hospital_navigator"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/hospital_navigator"
REDIS_URL="redis://localhost:6379/0"

# Security & Secrets
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Storage — "local" stores files under STORAGE_LOCAL_PATH.
STORAGE_BACKEND="local"
STORAGE_LOCAL_PATH="storage"

# Navpack signing — path to an Ed25519 private key in PEM format.
# Leave blank to skip package signing during development.
# Generate a dev key:  python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k=Ed25519PrivateKey.generate(); open('dev_signing_key.pem','wb').write(k.private_bytes(serialization.Encoding.PEM,serialization.PrivateFormat.PKCS8,serialization.NoEncryption()))"
NAVPACK_SIGNING_KEY_PATH=""